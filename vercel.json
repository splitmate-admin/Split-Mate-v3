{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{firebase-applet-config.json,groups_db.json,leaders_db.json,api/api-app.ts,src/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
